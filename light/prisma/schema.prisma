generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ENCADRANT
  ADMIN
}

enum ProjectRole {
  OWNER
  CO_DIRECTOR
  SECRETARY
  MEMBER
}

enum ProjectStage {
  IDEALISATION
  CONCEPTION
  DEVELOPPEMENT
  TEST
  CONCRETISATION
}

enum StepStatus {
  IN_PROGRESS
  SUBMITTED // soumise, en attente de l'encadrant
  CHANGES_REQUESTED // l'encadrant demande des modifications
  COMPLETED // validée par l'encadrant
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

// ===== MESSAGERIE =====
enum ConversationType {
  DIRECT // message privé entre deux utilisateurs
  GROUP // groupe créé par un étudiant (souvent lié à un projet)
  CHANNEL // canal de filière créé par un encadrant
}

enum ChannelTrack {
  GL // Génie Logiciel
  SR // Systèmes et Réseaux
}

enum ConversationRole {
  ADMIN
  MEMBER
}

// ===== ASSISTANT IA =====
enum AssistantRole {
  USER
  ASSISTANT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  INVITATION
  VALIDATION
  MESSAGE
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String? // géré par Supabase Auth, conservé pour les données existantes
  firstName    String
  lastName     String
  avatarUrl    String?
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   ProjectMember[]
  ownedProjects Project[]       @relation("ProjectOwner")
  tasksAssigned Task[]          @relation("TaskAssignee")
  notifications Notification[]

  supervisedProjects   Project[]            @relation("ProjectSupervisor")
  conversationsCreated Conversation[]       @relation("ConversationCreator")
  conversationMembers  ConversationMember[]
  messages             Message[]
  assistantThreads     AssistantThread[]
  submissions          StepSubmission[]     @relation("SubmissionAuthor")
  reviews              StepSubmission[]     @relation("SubmissionReviewer")
}

model Project {
  id               String            @id @default(cuid())
  title            String
  description      String?
  sector           String?
  teamSize         Int               @default(1)
  stage            ProjectStage      @default(IDEALISATION)
  progress         Int               @default(0)
  budgetEstimated  Int?
  budgetSpent      Int               @default(0)
  ownerId          String
  owner            User              @relation("ProjectOwner", fields: [ownerId], references: [id])
  supervisorId     String?
  supervisor       User?             @relation("ProjectSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  members          ProjectMember[]
  tasks            Task[]
  notifications    Notification[]
  steps            ProjectStep[]
  conversations    Conversation[]
  assistantThreads AssistantThread[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([ownerId])
  @@index([supervisorId])
}

// Contenu d'une étape du parcours (formulaire stocké en JSON)
model ProjectStep {
  id          String       @id @default(cuid())
  projectId   String
  stage       ProjectStage
  status      StepStatus   @default(IN_PROGRESS)
  data        Json         @default("{}")
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissions StepSubmission[]

  @@unique([projectId, stage])
}

// Un tour d'accompagnement : soumission de l'étudiant puis décision de l'encadrant
model StepSubmission {
  id          String          @id @default(cuid())
  stepId      String
  authorId    String
  note        String? // message de l'étudiant à l'encadrant
  data        Json // instantané du contenu soumis
  submittedAt DateTime        @default(now())
  decision    ReviewDecision? // null tant que l'encadrant n'a pas statué
  feedback    String?
  rating      Int?
  reviewerId  String?
  reviewedAt  DateTime?

  step     ProjectStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  author   User        @relation("SubmissionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewer User?       @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([stepId, submittedAt])
  @@index([reviewerId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  status    String      @default("ONLINE") // ONLINE | OFFLINE | AWAY
  joinedAt  DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Task {
  id         String       @id @default(cuid())
  projectId  String
  title      String
  status     TaskStatus   @default(TODO)
  priority   TaskPriority @default(MEDIUM)
  assigneeId String?
  dueDate    DateTime?
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee   User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([projectId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  projectId String?
  type      NotificationType
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ============================================================
// MESSAGERIE
// ============================================================
model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType
  name          String? // groupes et canaux
  description   String?
  track         ChannelTrack? // canaux uniquement
  projectId     String? // groupe rattaché à un projet (facultatif)
  directKey     String?          @unique // messages privés : "idA:idB" trié, garantit une seule conversation par paire
  createdById   String
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  createdBy User                 @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  project   Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  members   ConversationMember[]
  messages  Message[]

  @@index([type, lastMessageAt])
}

model ConversationMember {
  id             String           @id @default(cuid())
  conversationId String
  userId         String
  role           ConversationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())
  lastReadAt     DateTime         @default(now()) // messages plus récents = non lus

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ============================================================
// ASSISTANT IA (mentor entrepreneurial)
// ============================================================
model AssistantThread {
  id        String   @id @default(cuid())
  userId    String
  projectId String? // projet analysé par l'assistant (facultatif)
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages AssistantMessage[]

  @@index([userId, updatedAt])
}

model AssistantMessage {
  id        String        @id @default(cuid())
  threadId  String
  role      AssistantRole
  content   String
  sources   Json? // sources web citées : [{ title, url }]
  createdAt DateTime      @default(now())

  thread AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}
