# Variables d'environnement de LIGHT
# En local : copiez ce fichier en .env.local et remplissez les valeurs.
# Sur Vercel : Project Settings → Environment Variables (Production, Preview et Development).
# Ne commitez jamais les vraies valeurs.

# ---------- Supabase (Project Settings → API) ----------
# URL du projet et clé publique : exposées au navigateur, c'est normal
NEXT_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clé anon / publishable>

# Accès administrateur, serveur uniquement (pièces jointes, photos de profil, suppression de compte). À garder secret.
SUPABASE_URL=https://<projet>.supabase.co
SUPABASE_SECRET_KEY=<clé secrète / service_role>

# ---------- Base de données (Project Settings → Database → Connect) ----------
# Application : pooler en mode TRANSACTION (port 6543), indispensable en serverless sur Vercel
DATABASE_URL=postgresql://postgres.<projet>:<mot-de-passe>@aws-0-<région>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations Prisma : pooler en mode SESSION (port 5432) ou connexion directe
DIRECT_URL=postgresql://postgres.<projet>:<mot-de-passe>@aws-0-<région>.pooler.supabase.com:5432/postgres
# Facultatif : taille du pool de connexions par instance (3 par défaut sur Vercel, 5 en local)
# DATABASE_POOL_MAX=3

# ---------- Assistant IA ----------
# Clé Google Gemini (gratuite) : https://aistudio.google.com/apikey
# Sans cette clé, le mentor IA affiche un message « non configuré » au lieu de répondre
GEMINI_API_KEY=<clé API Gemini>
# Facultatif : modèle utilisé (gemini-2.5-flash par défaut) et recherche web Google (activée par défaut)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_WEB_SEARCH=false
